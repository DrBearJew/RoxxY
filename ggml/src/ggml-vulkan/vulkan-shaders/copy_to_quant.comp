uint nearest_centroid_planar3(float val) {
    float c[8];
    c[0] = -0.190685f; c[1] = -0.117832f; c[2] = -0.065717f; c[3] = -0.021460f;
    c[4] =  0.021460f; c[5] =  0.065717f; c[6] =  0.117832f; c[7] =  0.190685f;

    uint best = 0;
    float best_d = abs(val - c[0]);
    [[unroll]] for (uint i = 1; i < 8; i++) {
        float d = abs(val - c[i]);
        if (d < best_d) { best_d = d; best = i; }
    }
    return best;
}

void quantize(uint dst_idx, uint src_idx)
{
    float c[8];
    c[0] = -0.190685f; c[1] = -0.117832f; c[2] = -0.065717f; c[3] = -0.021460f;
    c[4] =  0.021460f; c[5] =  0.065717f; c[6] =  0.117832f; c[7] =  0.190685f;

    float norm_sq = 0.0f;
    [[unroll]] for (int j = 0; j < QUANT_K_PLANAR3_0; j++) {
        float v = data_s[src_idx + j];
        norm_sq += v * v;
    }
    float grp_norm = sqrt(norm_sq);
    float inv_norm = (grp_norm > 1e-10f) ? 1.0f / grp_norm : 0.0f;

    [[unroll]] for (int j = 0; j < QUANT_K_PLANAR3_0 / 4; j++) {
        data_q[dst_idx].qs[j] = uint8_t(0);
    }
    [[unroll]] for (int j = 0; j < QUANT_K_PLANAR3_0 / 8; j++) {
        data_q[dst_idx].signs[j] = uint8_t(0);
    }

    float recon_sq = 0.0f;
    [[unroll]] for (int p = 0; p < QUANT_K_PLANAR3_0 / 2; p++) {
        float v0 = data_s[src_idx + p * 2] * inv_norm;
        float v1 = data_s[src_idx + p * 2 + 1] * inv_norm;

        float cos_val = PI_COS[p % 64];
        float sin_val = PI_SIN[p % 64];
        float r0 = cos_val * v0 - sin_val * v1;
        float r1 = sin_val * v0 + cos_val * v1;

        uint idx0 = nearest_centroid_planar3(r0);
        uint idx1 = nearest_centroid_planar3(r1);

        uint j0 = p * 2;
        uint j1 = p * 2 + 1;

        data_q[dst_idx].qs[j0 / 4] |= uint8_t((idx0 & 0x3u) << ((j0 % 4) * 2));
        if ((idx0 & 0x4u) != 0) {
            data_q[dst_idx].signs[j0 / 8] |= uint8_t(1u << (j0 % 8));
        }

        data_q[dst_idx].qs[j1 / 4] |= uint8_t((idx1 & 0x3u) << ((j1 % 4) * 2));
        if ((idx1 & 0x4u) != 0) {
            data_q[dst_idx].signs[j1 / 8] |= uint8_t(1u << (j1 % 8));
        }

        recon_sq += c[idx0] * c[idx0];
        recon_sq += c[idx1] * c[idx1];
    }

    float recon_norm = sqrt(recon_sq);
    float corrected = (recon_norm > 1e-10f) ? grp_norm / recon_norm : grp_norm;
    data_q[dst_idx].d = float16_t(corrected);
}
