uint nearest_centroid_iso3(float val) {
    float c[8];
    c[0] = -0.190685f; c[1] = -0.117832f; c[2] = -0.065717f; c[3] = -0.021460f;
    c[4] =  0.021460f; c[5] =  0.065717f; c[6] =  0.117832f; c[7] =  0.190685f;

    uint best = 0;
    float best_d = abs(val - c[0]);
    [[unroll]] for (uint i = 1; i < 8; i++) {
        float d = abs(val - c[i]);
        if (d < best_d) { best_d = d; best = i; }
    }
    return best;
}

void quantize(uint dst_idx, uint src_idx)
{
    float c[8];
    c[0] = -0.190685f; c[1] = -0.117832f; c[2] = -0.065717f; c[3] = -0.021460f;
    c[4] =  0.021460f; c[5] =  0.065717f; c[6] =  0.117832f; c[7] =  0.190685f;

    float norm_sq = 0.0f;
    [[unroll]] for (int j = 0; j < QUANT_K_ISO3_0; j++) {
        float v = data_s[src_idx + j];
        norm_sq += v * v;
    }
    float grp_norm = sqrt(norm_sq);
    float inv_norm = (grp_norm > 1e-10f) ? 1.0f / grp_norm : 0.0f;

    [[unroll]] for (int j = 0; j < QUANT_K_ISO3_0 / 4; j++) {
        data_q[dst_idx].qs[j] = uint8_t(0);
    }
    [[unroll]] for (int j = 0; j < QUANT_K_ISO3_0 / 8; j++) {
        data_q[dst_idx].signs[j] = uint8_t(0);
    }

    float recon_sq = 0.0f;
    [[unroll]] for (int g = 0; g < QUANT_K_ISO3_0 / 4; g++) {
        float v0 = data_s[src_idx + g*4 + 0] * inv_norm;
        float v1 = data_s[src_idx + g*4 + 1] * inv_norm;
        float v2 = data_s[src_idx + g*4 + 2] * inv_norm;
        float v3 = data_s[src_idx + g*4 + 3] * inv_norm;

        float qw = PI_QW_ISO[g], qx = PI_QX_ISO[g], qy = PI_QY_ISO[g], qz = PI_QZ_ISO[g];
        float rw = qw*v0 - qx*v1 - qy*v2 - qz*v3;
        float rx = qw*v1 + qx*v0 + qy*v3 - qz*v2;
        float ry = qw*v2 - qx*v3 + qy*v0 + qz*v1;
        float rz = qw*v3 + qx*v2 - qy*v1 + qz*v0;

        float rotated[4] = {rw, rx, ry, rz};
        [[unroll]] for (int k = 0; k < 4; k++) {
            int j = g * 4 + k;
            uint idx = nearest_centroid_iso3(rotated[k]);
            data_q[dst_idx].qs[j / 4] |= uint8_t((idx & 0x3u) << ((j % 4) * 2));
            if ((idx & 0x4u) != 0) {
                data_q[dst_idx].signs[j / 8] |= uint8_t(1u << (j % 8));
            }
            recon_sq += c[idx] * c[idx];
        }
    }

    float recon_norm = sqrt(recon_sq);
    float corrected = (recon_norm > 1e-10f) ? grp_norm / recon_norm : grp_norm;
    data_q[dst_idx].d = float16_t(corrected);
}
